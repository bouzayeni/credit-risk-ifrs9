# Copy to .env. Paths may point to another drive when the system drive is small.
# Folder holding the raw Lending Club files and _manifest.json (default: data/raw).
CREDIT_RAW_DIR=data/raw
# Folder for cleaned/derived datasets (default: data/processed).
CREDIT_PROCESSED_DIR=data/processed

# PostgreSQL (Phase 2). The superuser is used only by credit_risk.warehouse.setup_db to
# create the database, tablespace and roles; everything else runs as the roles below.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me
CREDIT_DB_NAME=credit_dw
# Optional: keep the database files on another drive (folder must be writable by the
# PostgreSQL service account, e.g. NetworkService on Windows). Empty = default location.
CREDIT_DB_TABLESPACE_DIR=
# Owner of the warehouse schemas: loads data.
CREDIT_ETL_USER=credit_etl
CREDIT_ETL_PASSWORD=change-me
# Read-only on the warehouse, with a statement timeout: Power BI and analysis.
CREDIT_RO_USER=credit_ro
CREDIT_RO_PASSWORD=change-me

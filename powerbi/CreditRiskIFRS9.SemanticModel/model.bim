        "partitions": [
          {
            "name": "ECL Loan",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(Server, Database),",
                "    Data = Source{[Schema = \"bi\", Item = \"ecl_loan\"]}[Data]",
                "in",
                "    Data"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Loans",
            "expression": "COUNTROWS('ECL Loan')",
            "formatString": "#,0",
            "lineageTag": "fc6a3f70-070e-55f0-bd91-53184365b784"
          },
          {
            "name": "Gross Carrying Amount",
            "expression": "SUM('ECL Loan'[gross_carrying_amt])",
            "formatString": "\\$#,0",
            "lineageTag": "88f95edc-fed8-59c9-bc8f-b91ca83066b6"
          },
          {
            "name": "ECL",
            "expression": "SUM('ECL Loan'[ecl])",
            "formatString": "\\$#,0",
            "lineageTag": "e33879ca-7839-5663-a261-c4de80133a98"
          },
          {
            "name": "Coverage",
            "expression": "DIVIDE([ECL], [Gross Carrying Amount])",
            "formatString": "0.00%",
            "lineageTag": "33c5a570-2043-5572-b9ee-9f0296c4ca4d"
          },
          {
            "name": "ECL Base",
            "expression": "SUM('ECL Loan'[ecl_base])",
            "formatString": "\\$#,0",
            "lineageTag": "1dfb9c74-7e66-5f85-9e3d-7a02a3e6535a"
          },
          {
            "name": "ECL Upside",
            "expression": "SUM('ECL Loan'[ecl_upside])",
            "formatString": "\\$#,0",
            "lineageTag": "d634ab26-e110-5ed8-ad92-bec82e988078"
          },
          {
            "name": "ECL Downside",
            "expression": "SUM('ECL Loan'[ecl_downside])",
            "formatString": "\\$#,0",
            "lineageTag": "b641b5d1-2c2b-5b74-8679-ef62425c7f69"
          },
          {
            "name": "Scenario Uplift vs Base",
            "expression": "DIVIDE([ECL], [ECL Base]) - 1",
            "formatString": "0.0%",
            "lineageTag": "e33f9a69-32e1-55cf-b226-f584c3731ec2"
          },
          {
            "name": "Stage 2 Share",
            "expression": "DIVIDE(CALCULATE([Gross Carrying Amount], 'ECL Loan'[stage] = 2), [Gross Carrying Amount])",
            "formatString": "0.0%",
            "lineageTag": "db429115-02f5-5315-958d-b8484bd2c3ad"
          },
          {
            "name": "Stage 3 Share",
            "expression": "DIVIDE(CALCULATE([Gross Carrying Amount], 'ECL Loan'[stage] = 3), [Gross Carrying Amount])",
            "formatString": "0.0%",
            "lineageTag": "9e4d8cd0-2dd7-5418-bcc6-07a4e7af9659"
          },
          {
            "name": "Downgraded Share",
            "expression": "DIVIDE(CALCULATE([Loans], 'ECL Loan'[notches_upgraded] < 0), [Loans])",
            "formatString": "0.0%",
            "lineageTag": "ef986ebf-db4a-5b3e-8e71-4b14f68fa4f6"
          },
          {
            "name": "Forward 12m PD",
            "expression": "AVERAGE('ECL Loan'[pd_12m_fwd_base])",
            "formatString": "0.00%",
            "lineageTag": "41d3e396-ee6a-572e-a3b1-37bce708fa60"
          }
        ]
      },
